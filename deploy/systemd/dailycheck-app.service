# deploy/systemd/dailycheck-app.service
# DailyCheck Flask dev server (port 8080, --debug for live reload)
# 安装到 wdg-systemd 容器内 /etc/systemd/system/ 用 scripts/install-in-wdg-systemd.sh
[Unit]
Description=DailyCheck Flask App (dev mode on :8080)
Documentation=file:/opt/dailycheck/CLAUDE.md
After=network.target
PartOf=wdg.target
Wants=wdg.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/dailycheck
# Secrets live outside the repo. scripts/install-in-wdg-systemd.sh creates
# /etc/dailycheck/app.env with dev defaults; production supplies a strong
# DAILYCHECK_SECRET_KEY + DAILYCHECK_ENV=production there.
# Leading '-' tolerates a missing file so a fresh container still boots.
EnvironmentFile=-/etc/dailycheck/app.env
Environment=FLASK_DEBUG=1
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/var/www/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -m flask --app app run --host 0.0.0.0 --port 8080 --debug
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=wdg.target multi-user.target